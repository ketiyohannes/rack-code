{
  "name": "rack",
  "version": "1.0.0",
  "private": true,
  "description": "Rack: a coding agent harness. Monorepo root for the shared packages and the applications that run them.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json && npm run typecheck --workspaces --if-present",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "test": "tsx --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run check:boundaries && npm test && npm run build:desktop && npm run build:web",
    "start": "npm run start --workspace @rack/desktop",
    "start:daemon": "npm run start --workspace @rack/daemon",
    "start:web": "npm run start --workspace @rack/web",
    "build": "npm run build:desktop && npm run build:web",
    "build:desktop": "npm run build --workspace @rack/desktop",
    "build:web": "npm run build --workspace @rack/web",
    "build:mobile": "npm run build --workspace @rack/mobile",
    "package:desktop": "npm run package --workspace @rack/desktop",
    "archive:desktop": "npm run archive --workspace @rack/desktop",
    "daemon:token": "npm run print-token --workspace @rack/daemon",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "test:desktop-features": "npm run test:desktop-features --workspace @rack/desktop",
    "test:orchestra": "npm run test:orchestra --workspace @rack/desktop",
    "test:run-changes": "npm run test:run-changes --workspace @rack/desktop",
    "test:tool-groups": "npm run test:tool-groups --workspace @rack/desktop",
    "demo:tool-groups": "npm run demo:tool-groups --workspace @rack/desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
